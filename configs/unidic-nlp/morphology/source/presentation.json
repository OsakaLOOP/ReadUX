  "rule_tree": [
    {
      "id": "verb-cycle",
      "label": "动词循环类",
      "summary": "动词范畴内的有限活用转移",
      "input_examples": [
        "未然形",
        "连用形",
        "终止形"
      ],
      "output": "动词",
      "children": [
        {
          "id": "verb-cycle-imperfective",
          "label": "未然形输入",
          "input_examples": [
            "五段",
            "一段・变格"
          ],
          "output": "ない／せる／れる"
        },
        {
          "id": "verb-cycle-continuative",
          "label": "连用形输入",
          "input_examples": [
            "礼貌层",
            "补助层入口"
          ],
          "output": "ます／て・で"
        },
        {
          "id": "verb-cycle-ending",
          "label": "终止形收尾",
          "input_examples": [
            "意向",
            "禁止或推量"
          ],
          "output": "う／よう／まい"
        }
      ]
    },
    {
      "id": "auxiliary-verb",
      "label": "补助动词类",
      "summary": "连接器与补助用言形成递归父子链",
      "input_examples": [
        "て／で形",
        "连用形",
        "たり"
      ],
      "output": "动词或形容词",
      "children": [
        {
          "id": "auxiliary-te",
          "label": "て形接续",
          "input_examples": [
            "持续与状态",
            "完成与遗憾"
          ],
          "output": "いる／しまう"
        },
        {
          "id": "auxiliary-direction",
          "label": "趋向与处置",
          "input_examples": [
            "预先处置",
            "趋向与变化"
          ],
          "output": "おく／いく／くる"
        },
        {
          "id": "auxiliary-continuative",
          "label": "连用形补助",
          "input_examples": [
            "开始、继续、结束",
            "程度、反复、相互"
          ],
          "output": "始める／続ける／すぎる"
        }
      ]
    },
    {
      "id": "insertion",
      "label": "插入语类",
      "summary": "不改变前项状态的范围扩展",
      "input_examples": [
        "对比与提示",
        "限定与强调",
        "列举与举例"
      ],
      "output": "保持前项状态"
    },
    {
      "id": "na-adjective-judgement",
      "label": "ナ形容词判断类",
      "summary": "先形成判断词干，再按だ／な／で等形式收尾",
      "input_examples": [
        "普通形输入",
        "词干输入",
        "名词修饰输入"
      ],
      "output": "形状词／判断结构",
      "children": [
        {
          "id": "na-adjective-evidential",
          "label": "样态与传闻",
          "input_examples": [
            "そうだ",
            "らしい"
          ],
          "output": "判断词干"
        },
        {
          "id": "na-adjective-inference",
          "label": "推量与比喻",
          "input_examples": [
            "ようだ",
            "みたいだ"
          ],
          "output": "形状词词干"
        },
        {
          "id": "na-adjective-norm",
          "label": "预期与规范",
          "input_examples": [
            "はずだ",
            "べきだ"
          ],
          "output": "判断收尾"
        }
      ]
    },
    {
      "id": "i-adjective-conversion",
      "label": "イ形容词转换类",
      "summary": "把动词或助动词整体转换为イ形容词性状态",
      "input_examples": [
        "未然形输入",
        "连用形输入",
        "前一转换形输入"
      ],
      "output": "イ形容词",
      "children": [
        {
          "id": "i-adjective-desire",
          "label": "主观愿望",
          "input_examples": [
            "たい",
            "たくない"
          ],
          "output": "イ形容词性整体"
        },
        {
          "id": "i-adjective-negative",
          "label": "否定转换",
          "input_examples": [
            "ない",
            "なかった"
          ],
          "output": "イ形容词性整体"
        },
        {
          "id": "i-adjective-evaluation",
          "label": "难易与倾向",
          "input_examples": [
            "やすい",
            "にくい／づらい"
          ],
          "output": "イ形容词性整体"
        }
      ]
    },
    {
      "id": "classical-conjugation",
      "label": "文言活用类",
      "summary": "按文语活用表处理古典用言和助动结构",
      "input_examples": [
        "ク活用",
        "シク活用",
        "文语助动词"
      ],
      "output": "文语用言／文语助动结构",
      "children": [
        {
          "id": "classical-adjective",
          "label": "ク・シク活用表",
          "input_examples": [
            "未然形与连用形",
            "终止形与连体形"
          ],
          "output": "文语形容词"
        },
        {
          "id": "classical-auxiliary",
          "label": "文语助动词",
          "input_examples": [
            "ず／ぬ",
            "べし"
          ],
          "output": "文语助动结构"
        },
        {
          "id": "classical-gotoshi",
          "label": "ごとし类接续",
          "input_examples": [
            "ごとし",
            "ごとき"
          ],
          "output": "文语判断结构"
        }
      ]
    }
  ],
