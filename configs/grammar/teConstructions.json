      "pronunciation": "てくれる",
      "variants": [
        { "surface": "でくれる", "subtype": "助動詞", "note": "接在拨音便、浊音便后" }
      ],
      "senses": [
        {
          "id": "auxiliary:te-kureru:benefactive",
          "subtype": "助動詞",
          "title": "他人为我方做事",
          "meaning": "表示他人为说话人或我方完成前项动作，常带有受益或感激的语气。",
          "connection": "动词て形＋くれる；拨音便、浊音便后使用「でくれる」。",
          "examples": [
            { "ja": "友達が荷物を持ってくれた。", "zh": "朋友帮我拿了行李。" }
          ]
        }
      ]
    },
    {
      "id": "auxiliary:te-yaru",
      "headword": "てやる",
      "reading": "てやる",
      "pronunciation": "てやる",
      "variants": [
        { "surface": "でやる", "subtype": "助動詞", "note": "接在拨音便、浊音便后" }
      ],
      "senses": [
        {
          "id": "auxiliary:te-yaru:benefactive",
          "subtype": "助動詞",
          "title": "为对方做事",
          "meaning": "表示说话人一方为对方或关系较近、地位较低的对象完成前项动作；语气可能显得随便或强势。",
          "connection": "动词て形＋やる；拨音便、浊音便后使用「でやる」。",
          "examples": [
            { "ja": "子犬に水を飲ませてやった。", "zh": "我让小狗喝了水。" }
          ]
        }
      ]
    },
