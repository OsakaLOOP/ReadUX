    },
    {
      "id": "auxiliary:tamaranai-component",
      "headword": "たまらない",
      "reading": "たまらない",
      "pronunciation": "たまらない",
      "variants": [],
      "senses": [
        {
          "id": "auxiliary:tamaranai-component:feeling",
          "subtype": "补助动词",
          "title": "难以抑制",
          "meaning": "在「てたまらない」中表示感受或欲望强烈得无法抑制。",
          "connection": "动词、イ形容词て形＋たまらない；ナ形容词词干＋でたまらない。",
          "examples": [
            {
              "ja": "早く会いたくてたまらない。",
              "zh": "迫不及待地想早点见面。"
            }
          ]
        }
      ]
    },
    {
      "id": "auxiliary:naranai-component",
      "headword": "ならない",
      "reading": "ならない",
      "pronunciation": "ならない",
      "variants": [],
      "senses": [
        {
          "id": "auxiliary:naranai-component:feeling",
          "subtype": "补助动词",
          "title": "不由得产生感受",
          "meaning": "在「てならない」中表示某种感受或想法自然涌现，难以抑制。",
          "connection": "动词、イ形容词て形＋ならない；ナ形容词词干＋でならない。",
          "examples": [
            {
              "ja": "将来が心配でならない。",
              "zh": "不由得担心未来。"
            }
          ]
        }
      ]
    },
    {
      "id": "auxiliary:yamanai-component",
      "headword": "やまない",
      "reading": "やまない",
      "pronunciation": "やまない",
      "variants": [],
      "senses": [
        {
          "id": "auxiliary:yamanai-component:feeling",
          "subtype": "补助动词",
          "title": "持续怀有感情",
          "meaning": "在「てやまない」中表示持续怀有强烈的感情、愿望或信念。",
          "connection": "动词连用形＋てやまない。",
          "examples": [
            {
              "ja": "平和を願ってやまない。",
              "zh": "始终祈愿和平。"
            }
          ]
        }
      ]
    }
