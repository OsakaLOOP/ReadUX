  "entries": [
    {
      "id": "auxiliary:aru-component",
      "headword": "ある",
      "reading": "ある",
      "pronunciation": "ある",
      "variants": [],
      "senses": [
        {
          "id": "auxiliary:aru-component:result",
          "subtype": "补助动词",
          "title": "保持动作结果",
          "meaning": "在「てある」中表示他动动作完成后留下的状态仍然保持。",
          "connection": "他动词て形＋ある；拨音便、浊音便后使用「である」。",
          "examples": [
            {
              "ja": "資料が机に並べてある。",
              "zh": "资料已经摆在桌上。"
            }
          ]
        }
      ]
    },
    {
      "id": "auxiliary:shimau-component",
      "headword": "しまう",
      "reading": "しまう",
      "pronunciation": "しまう",
      "variants": [],
      "senses": [
        {
          "id": "auxiliary:shimau-component:completion",
          "subtype": "补助动词",
          "title": "完成或遗憾",
          "meaning": "在「てしまう」中表示动作彻底完成，或说话人对结果感到遗憾、意外。",
          "connection": "动词て形＋しまう；拨音便、浊音便后使用「でしまう」。",
          "examples": [
            {
              "ja": "財布を落としてしまった。",
              "zh": "把钱包给弄丢了。"
            }
          ]
        }
      ]
    },
    {
      "id": "auxiliary:oku-component",
      "headword": "おく",
      "reading": "おく",
      "pronunciation": "おく",
      "variants": [],
      "senses": [
        {
          "id": "auxiliary:oku-component:preparation",
          "subtype": "补助动词",
          "title": "预先处置",
          "meaning": "在「ておく」中表示为之后的安排预先完成动作，或有意保持动作结果。",
          "connection": "动词て形＋おく；拨音便、浊音便后使用「でおく」。",
          "examples": [
            {
              "ja": "必要な資料を印刷しておく。",
              "zh": "先把需要的资料打印好。"
            }
          ]
        }
      ]
    },
    {
      "id": "auxiliary:iku-component",
