          "connection": "动词て形＋いく；拨音便、浊音便后使用「でいく」。",
          "examples": [
            {
              "ja": "町の景色が変わっていく。",
              "zh": "城镇的景色逐渐变化。"
            }
          ]
        }
      ]
    },
    {
      "id": "auxiliary:yuku-component",
      "headword": "ゆく",
      "reading": "ゆく",
      "pronunciation": "ゆく",
      "variants": [],
      "senses": [
        {
          "id": "auxiliary:yuku-component:direction",
          "subtype": "补助动词",
          "title": "远离与持续发展",
