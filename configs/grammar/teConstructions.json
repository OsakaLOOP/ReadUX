        {
          "id": "auxiliary:miru-component:attempt",
          "subtype": "补助动词",
          "title": "尝试",
          "meaning": "在「てみる」中表示尝试进行前项动作，以观察结果。",
          "connection": "动词て形＋みる；拨音便、浊音便后使用「でみる」。",
          "examples": [
            {
              "ja": "別の方法を試してみる。",
              "zh": "试试别的方法。"
            }
          ]
        }
      ]
    },
    {
      "id": "auxiliary:kudasaru-component",
      "headword": "くださる",
      "reading": "くださる",
      "pronunciation": "くださる",
      "variants": [],
      "senses": [
        {
          "id": "auxiliary:kudasaru-component:benefactive",
          "subtype": "补助动词",
          "title": "他人为我方做事（尊敬）",
          "meaning": "在「てくださる」中表示说话人或我方得到他人的动作，并对动作主体表示敬意。",
          "connection": "动词て形＋くださる；拨音便、浊音便后使用「でくださる」。",
          "examples": [
            {
              "ja": "先輩が手伝ってくださった。",
              "zh": "前辈帮了我。"
            }
          ]
        }
      ]
    },
    {
      "id": "auxiliary:morau-component",
      "headword": "もらう",
      "reading": "もらう",
      "pronunciation": "もらう",
      "variants": [],
      "senses": [
        {
          "id": "auxiliary:morau-component:benefactive",
          "subtype": "补助动词",
          "title": "得到他人帮助",
          "meaning": "在「てもらう」中表示说话人或相关一方得到他人的动作，也可用于请求。",
          "connection": "动词て形＋もらう；拨音便、浊音便后使用「でもらう」。",
          "examples": [
            {
              "ja": "同僚に確認してもらう。",
              "zh": "请同事帮忙确认。"
            }
          ]
        }
      ]
    },
    {
      "id": "auxiliary:ageru-component",
      "headword": "あげる",
      "reading": "あげる",
      "pronunciation": "あげる",
      "variants": [],
      "senses": [
        {
          "id": "auxiliary:ageru-component:benefactive",
          "subtype": "补助动词",
          "title": "为他人做事",
          "meaning": "在「てあげる」中表示说话人一方为他人完成前项动作。",
          "connection": "动词て形＋あげる；拨音便、浊音便后使用「であげる」。",
          "examples": [
            {
              "ja": "道を教えてあげた。",
              "zh": "我给对方指了路。"
            }
          ]
        }
      ]
    },
    {
      "id": "auxiliary:kureru-component",
      "headword": "くれる",
      "reading": "くれる",
      "pronunciation": "くれる",
      "variants": [],
      "senses": [
        {
          "id": "auxiliary:kureru-component:benefactive",
          "subtype": "补助动词",
          "title": "他人为我方做事",
          "meaning": "在「てくれる」中表示他人为说话人或我方完成前项动作。",
          "connection": "动词て形＋くれる；拨音便、浊音便后使用「でくれる」。",
          "examples": [
            {
              "ja": "家族が迎えに来てくれた。",
              "zh": "家人来接我了。"
            }
          ]
        }
      ]
    },
    {
      "id": "auxiliary:yaru-component",
      "headword": "やる",
      "reading": "やる",
      "pronunciation": "やる",
      "variants": [],
      "senses": [
        {
          "id": "auxiliary:yaru-component:benefactive",
          "subtype": "补助动词",
          "title": "为对方做事",
          "meaning": "在「てやる」中表示说话人一方为对方或关系较近的对象完成前项动作，语气可能较随便或强势。",
          "connection": "动词て形＋やる；拨音便、浊音便后使用「でやる」。",
          "examples": [
            {
              "ja": "弟に宿題を教えてやった。",
              "zh": "我教弟弟做了作业。"
            }
          ]
        }
      ]
    },
    {
      "id": "auxiliary:volitional-u",
      "headword": "う",
      "reading": "う",
      "pronunciation": "う",
      "variants": [
        {
          "surface": "よう",
          "subtype": "助動詞",
          "note": "上一段、下一段及カ变、サ变动词使用「よう」"
        }
      ],
      "senses": [
        {
          "id": "auxiliary:volitional-u:intention",
          "subtype": "补助动词",
          "title": "意志与提议",
          "meaning": "接在动词未然形后表示说话人的意志或向对方提出建议。五段动词接「う」，其他动词通常接「よう」。",
          "connection": "五段动词未然形＋う；一段动词、カ变、サ变动词未然形＋よう。",
          "examples": [
            {
              "ja": "明日は早く起きよう。",
              "zh": "明天早点起床吧。"
            },
            {
              "ja": "一緒に帰ろう。",
              "zh": "一起回去吧。"
            }
          ]
        }
      ]
    },
    {
      "id": "auxiliary:hoshii-component",
      "headword": "ほしい",
      "reading": "ほしい",
      "pronunciation": "ほしい",
      "variants": [],
      "senses": [
        {
          "id": "auxiliary:hoshii-component:wish",
          "subtype": "补助动词",
          "title": "希望对方行动",
          "meaning": "在「てほしい」中表示说话人希望动作执行者实施前项动作。",
          "connection": "动作执行者＋动词て形＋ほしい。",
          "examples": [
            {
              "ja": "もう少し待ってほしい。",
              "zh": "希望你再等一会儿。"
            }
          ]
        }
      ]
    },
    {
      "id": "auxiliary:goran-component",
      "headword": "ごらん",
      "reading": "ごらん",
      "pronunciation": "ごらん",
      "variants": [],
      "senses": [
        {
          "id": "auxiliary:goran-component:suggestion",
          "subtype": "补助动词",
          "title": "劝对方尝试",
          "meaning": "在「てごらん」中构成亲近或上对下的建议语气。",
          "connection": "动词て形＋ごらん。",
          "examples": [
            {
              "ja": "自分で考えてごらん。",
              "zh": "自己想想看。"
            }
          ]
        }
      ]
    },
    {
      "id": "auxiliary:miseru-component",
      "headword": "みせる",
      "reading": "みせる",
      "pronunciation": "みせる",
      "variants": [],
      "senses": [
        {
          "id": "auxiliary:miseru-component:resolve",
          "subtype": "补助动词",
          "title": "决心做到",
          "meaning": "在「てみせる」中表示决心完成前项动作，并让他人看到结果。",
          "connection": "动词て形＋みせる。",
          "examples": [
            {
              "ja": "必ず成功してみせる。",
              "zh": "我一定会成功给你看。"
            }
          ]
        }
