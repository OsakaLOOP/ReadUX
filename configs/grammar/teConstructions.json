      "reading": "くる",
      "pronunciation": "くる",
      "variants": [],
      "senses": [
        {
          "id": "auxiliary:kuru-component:direction",
          "subtype": "补助动词",
          "title": "趋近与变化显现",
          "meaning": "在「てくる」中表示动作趋近参照点，或变化持续到现在并逐渐显现。",
          "connection": "动词て形＋くる；拨音便、浊音便后使用「でくる」。",
          "examples": [
            {
              "ja": "雨が強くなってきた。",
              "zh": "雨势渐渐大了起来。"
            }
          ]
        }
      ]
    },
    {
