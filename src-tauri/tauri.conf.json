{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReadUX",
  "mainBinaryName": "ReadUX",
  "version": "../package.json",
  "identifier": "com.readux.app",
  "build": {
    "beforeDevCommand": "npm run frontend:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ReadUX",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$DOCUMENT/ReadUX Library/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "publisher": "ReadUX",
    "license": "MIT",
    "resources": {
      "../release-resources/nlp/": "nlp/",
      "../release-resources/python/": "python/",
      "../release-resources/python-manifest.json": "manifest.json",
      "../data/dict-sources/": "dict-sources/",
      "../scripts/nlp_provider.py": "scripts/nlp_provider.py",
      "../scripts/nlp_adapters.py": "scripts/nlp_adapters.py",
      "../scripts/nlp_resources.py": "scripts/nlp_resources.py",
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
